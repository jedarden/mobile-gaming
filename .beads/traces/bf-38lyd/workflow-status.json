                    "args": [
                        "set -ex\n\napt-get update -q \u0026\u0026 apt-get install -y -q git\n\ngit clone --depth 1 --branch {{workflow.parameters.branch}} \\\n  \"https://x-access-token:${GH_TOKEN}@github.com/jedarden/mobile-gaming.git\" \\\n  /workspace\ncd /workspace\n\nnpm ci\nnpm run build\n\n# Bundle size budget: 3000KB JS, 150KB CSS\nJS_SIZE=$(du -sb dist/assets/*.js 2\u003e/dev/null | awk '{sum+=$1} END {print sum+0}')\nCSS_SIZE=$(du -sb dist/assets/*.css 2\u003e/dev/null | awk '{sum+=$1} END {print sum+0}')\nJS_BUDGET=$((3000 * 1024))\nCSS_BUDGET=$((150 * 1024))\necho \"JS: $((JS_SIZE / 1024))KB (budget 3000KB)  CSS: $((CSS_SIZE / 1024))KB (budget 150KB)\"\n[ \"$JS_SIZE\" -le \"$JS_BUDGET\" ] || { echo \"ERROR: JS bundle exceeds 3000KB\"; exit 1; }\n[ \"$CSS_SIZE\" -le \"$CSS_BUDGET\" ] || { echo \"ERROR: CSS bundle exceeds 150KB\"; exit 1; }\n\necho \"Build passed!\"\n"
