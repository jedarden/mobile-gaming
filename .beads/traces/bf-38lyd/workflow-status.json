            "namespaced/mobile-gaming-ci/lint": {
                "activeDeadlineSeconds": 300,
                "container": {
                    "args": [
                        "set -ex\n\napt-get update -q \u0026\u0026 apt-get install -y -q git jq\n\ngit clone --depth 1 --branch {{workflow.parameters.branch}} \\\n  \"https://x-access-token:${GH_TOKEN}@github.com/jedarden/mobile-gaming.git\" \\\n  /workspace\ncd /workspace\n\nnpm ci\n\n# No console.log in game source files\nif grep -r \"console\\.log\" src/games/*/state.js src/games/*/renderer.js \\\n    src/games/*/input.js src/games/*/generator.js 2\u003e/dev/null; then\n  echo \"ERROR: console.log statements found in game files\"\n  exit 1\nfi\n\n# Every game directory must have the 7 required scaffold files and \u003e= 3 levels\nfor game_dir in src/games/*/; do\n  game_name=$(basename \"$game_dir\")\n  echo \"Checking $game_name...\"\n  for file in index.html game.js state.js renderer.js input.js styles.css levels.json; do\n    [ -f \"$game_dir$file\" ] || { echo \"ERROR: $game_dir missing $file\"; exit 1; }\n  done\n  level_count=$(jq 'length' \"$game_dir/levels.json\" 2\u003e/dev/null || echo \"0\")\n  [ \"$level_count\" -ge 3 ] || { echo \"ERROR: $game_dir/levels.json has only $level_count levels (need \u003e= 3)\"; exit 1; }\ndone\n\necho \"Lint passed!\"\n"
                    ],
