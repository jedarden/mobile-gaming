{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/pull-the-pin.schema.json",
  "title": "Pull the Pin Level",
  "description": "Schema for validating Pull the Pin game levels",
  "type": "object",
  "required": ["version", "id", "title", "difficulty", "hero", "goal", "goblin"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for migration support"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique level identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display title for the level"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Difficulty rating from 1 (easy) to 10 (hard)"
    },
    "hero": {
      "type": "object",
      "required": ["x", "y", "radius"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "description": "Hero X position in logical pixels"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "description": "Hero Y position in logical pixels"
        },
        "radius": {
          "type": "number",
          "minimum": 5,
          "maximum": 50,
          "description": "Hero collision radius"
        }
      }
    },
    "goal": {
      "type": "object",
      "required": ["x", "y", "type", "width", "height"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "description": "Goal X position"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "description": "Goal Y position"
        },
        "type": {
          "type": "string",
          "enum": ["bucket", "portal", "zone"],
          "description": "Type of goal container"
        },
        "width": {
          "type": "number",
          "minimum": 10,
          "description": "Goal width"
        },
        "height": {
          "type": "number",
          "minimum": 10,
          "description": "Goal height"
        }
      }
    },
    "goblin": {
      "type": "object",
      "required": ["x", "y", "radius"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "description": "Goblin X position"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "description": "Goblin Y position"
        },
        "radius": {
          "type": "number",
          "minimum": 5,
          "maximum": 50,
          "description": "Goblin collision radius"
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "Array of game elements (balls, pins, platforms, etc.)",
      "items": {
        "type": "object",
        "required": ["type", "x", "y"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["ball", "pin", "platform", "wall", "spike", "bomb", "portal"],
            "description": "Element type"
          },
          "id": {
            "type": "string",
            "description": "Optional element identifier"
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "description": "Element X position"
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "description": "Element Y position"
          },
          "radius": {
            "type": "number",
            "minimum": 1,
            "description": "Radius for circular elements"
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "description": "Width for rectangular elements"
          },
          "height": {
            "type": "number",
            "minimum": 1,
            "description": "Height for rectangular elements"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Element color in hex"
          },
          "pinOrientation": {
            "type": "string",
            "enum": ["horizontal", "vertical", "diagonal"],
            "description": "Pin orientation (for pin elements)"
          },
          "pinLength": {
            "type": "number",
            "minimum": 10,
            "description": "Pin length"
          },
          "isStatic": {
            "type": "boolean",
            "description": "Whether the element is static (immovable)"
          },
          "isRemovable": {
            "type": "boolean",
            "description": "Whether the element can be removed by player action"
          },
          "linkedTo": {
            "type": "string",
            "description": "ID of linked element (for synchronized removal)"
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "description": "Array of wall boundaries",
      "items": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "minimum": 1 },
          "height": { "type": "number", "minimum": 1 }
        }
      }
    },
    "targetMoves": {
      "type": "integer",
      "minimum": 1,
      "description": "Target number of moves for optimal completion"
    },
    "parScore": {
      "type": "integer",
      "minimum": 0,
      "description": "Par score for this level"
    },
    "hints": {
      "type": "array",
      "description": "Optional hints for the player",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 5
    }
  }
}
