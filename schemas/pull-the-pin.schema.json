{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/pull-the-pin.schema.json",
  "title": "Pull the Pin Level",
  "description": "Schema for validating Pull the Pin game levels",
  "type": "object",
  "required": ["id", "pins", "balls", "cups", "channels", "difficulty"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique level identifier"
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "description": "Difficulty rating"
    },
    "pins": {
      "type": "array",
      "description": "Pins that block flow through channels",
      "items": {
        "type": "object",
        "required": ["id", "x", "y"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" }
        }
      }
    },
    "balls": {
      "type": "array",
      "description": "Balls that flow through channels to cups",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "color"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "color": { "type": "string" }
        }
      }
    },
    "cups": {
      "type": "array",
      "description": "Goal containers that catch colored balls",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "width", "height", "acceptColor"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "acceptColor": { "type": "string" }
        }
      }
    },
    "channels": {
      "type": "array",
      "description": "Paths that balls flow through",
      "items": {
        "type": "object",
        "required": ["segments"],
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "blockedByPin": {
            "type": "string",
            "description": "Pin ID that blocks this channel segment"
          }
        }
      }
    }
  }
}
