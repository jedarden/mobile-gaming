{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/giant-runner.schema.json",
  "title": "Giant Runner Level",
  "description": "Schema for validating Giant Runner game levels",
  "type": "object",
  "required": ["id", "courseLength", "startScale", "playerColor", "speed", "collectibles"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Unique numeric level identifier"
    },
    "courseLength": {
      "type": "integer",
      "minimum": 50,
      "maximum": 2000,
      "description": "Length of the course in world units"
    },
    "startScale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 5,
      "description": "Player starting scale multiplier"
    },
    "playerColor": {
      "type": "string",
      "description": "Player character color"
    },
    "speed": {
      "type": "number",
      "minimum": 1,
      "maximum": 20,
      "description": "Player movement speed"
    },
    "collectibles": {
      "type": "array",
      "minItems": 1,
      "description": "Array of collectible objects along the course",
      "items": {
        "type": "object",
        "required": ["x", "z", "color", "value"],
        "additionalProperties": false,
        "properties": {
          "x": {
            "type": "number",
            "description": "X position (lateral offset)"
          },
          "z": {
            "type": "number",
            "minimum": 0,
            "description": "Z position along the course"
          },
          "color": {
            "type": "string",
            "description": "Collectible color (matching = scale up, different = scale down)"
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Scale change magnitude"
          }
        }
      }
    },
    "obstacles": {
      "type": "array",
      "description": "Array of obstacles along the course",
      "items": {
        "type": "object",
        "required": ["x", "z", "width"],
        "properties": {
          "x": { "type": "number" },
          "z": { "type": "number", "minimum": 0 },
          "width": { "type": "number" }
        }
      }
    },
    "boss": {
      "type": "object",
      "required": ["z", "scale"],
      "properties": {
        "z": { "type": "number" },
        "scale": { "type": "number" }
      }
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "description": "Difficulty factor"
    }
  }
}
