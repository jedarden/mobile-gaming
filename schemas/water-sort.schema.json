{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/water-sort.schema.json",
  "title": "Water Sort Level",
  "description": "Schema for validating Water Sort game levels",
  "type": "object",
  "required": ["id", "difficulty", "tubes", "maxSegments"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "maxLength": 100,
      "description": "Unique level identifier"
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "description": "Difficulty rating (0.0-1.0 normalized)"
    },
    "optimal": {
      "type": "integer",
      "minimum": 1,
      "description": "Optimal number of moves to solve"
    },
    "tubes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 15,
      "description": "Array of test tubes; each tube is an array of color strings (empty = empty tube)",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "Color name"
        }
      }
    },
    "maxSegments": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum tube capacity (segment count per tube)"
    }
  }
}
