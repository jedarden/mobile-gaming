{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/jelly-shift.schema.json",
  "title": "Jelly Shift Level",
  "description": "Schema for validating Jelly Shift game levels",
  "type": "object",
  "required": ["id", "walls", "speed", "difficulty"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Unique numeric level identifier"
    },
    "walls": {
      "type": "array",
      "minItems": 1,
      "description": "Array of walls with holes that the jelly must pass through",
      "items": {
        "type": "object",
        "required": ["z", "hole"],
        "additionalProperties": false,
        "properties": {
          "z": {
            "type": "number",
            "minimum": 0,
            "description": "Z-position of the wall along the course"
          },
          "hole": {
            "type": "object",
            "required": ["shape"],
            "properties": {
              "shape": {
                "type": "string",
                "enum": ["wide", "tall", "plus"],
                "description": "Shape of the hole"
              },
              "width": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 5,
                "description": "Width (for wide/tall shapes)"
              },
              "height": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 5,
                "description": "Height (for wide/tall shapes)"
              },
              "widthH": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 5,
                "description": "Horizontal arm width (for plus shape)"
              },
              "heightH": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 5,
                "description": "Horizontal arm height (for plus shape)"
              },
              "widthV": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 5,
                "description": "Vertical arm width (for plus shape)"
              },
              "heightV": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 5,
                "description": "Vertical arm height (for plus shape)"
              }
            }
          }
        }
      }
    },
    "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 20,
      "description": "Player movement speed along Z axis"
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Difficulty factor (0=easiest, 1=hardest)"
    }
  }
}
