{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/merge-games.schema.json",
  "title": "Merge Games Level",
  "description": "Schema for validating Merge Games puzzle levels",
  "type": "object",
  "required": ["id", "width", "height", "grid", "task", "difficulty"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^mg-",
      "description": "Unique level identifier (mg-... format)"
    },
    "width": {
      "type": "integer",
      "minimum": 3,
      "maximum": 10,
      "description": "Grid width in cells"
    },
    "height": {
      "type": "integer",
      "minimum": 3,
      "maximum": 10,
      "description": "Grid height in cells"
    },
    "grid": {
      "type": "array",
      "description": "2D grid of tile tiers (0 = empty, 1+ = tier)",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      }
    },
    "task": {
      "type": "object",
      "required": ["targetTier", "targetCount"],
      "additionalProperties": false,
      "properties": {
        "targetTier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "Target merge tier to achieve"
        },
        "targetCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Number of target tier items to create"
        }
      }
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"],
      "description": "Difficulty tier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display title for the level"
    }
  }
}
