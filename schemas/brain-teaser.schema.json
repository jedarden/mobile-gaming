{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobile-gaming.example.com/schemas/brain-teaser.schema.json",
  "title": "Brain Teaser Puzzle",
  "description": "Schema for validating Brain Teaser tap/drag/sequence puzzles",
  "type": "object",
  "required": ["id", "title", "prompt", "type", "elements", "solution", "decoyActions", "hint", "difficulty"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bt-[0-9]{3}$",
      "description": "Unique puzzle identifier (e.g. bt-001)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display title for the puzzle"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "The question or instruction shown to the player"
    },
    "type": {
      "type": "string",
      "enum": ["tap", "drag", "sequence"],
      "description": "Interaction type for the puzzle"
    },
    "showBanner": {
      "type": "boolean",
      "description": "Whether to show a banner overlay (used for misdirection puzzles)"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "description": "Visual elements that make up the puzzle",
      "items": {
        "type": "object",
        "required": ["id", "type", "x", "y", "w", "h"],
        "properties": {
          "id": { "type": "string", "description": "Element identifier" },
          "type": { "type": "string", "description": "Visual type (circle, rect, text, cup, key, etc.)" },
          "x": { "type": "number", "minimum": 0, "description": "X position in logical pixels" },
          "y": { "type": "number", "minimum": 0, "description": "Y position in logical pixels" },
          "w": { "type": "number", "minimum": 1, "description": "Width in logical pixels" },
          "h": { "type": "number", "minimum": 1, "description": "Height in logical pixels" },
          "color": { "type": "string", "description": "CSS color value" },
          "label": { "type": "string", "description": "Text label rendered inside the element" },
          "text": { "type": "string", "description": "Text content (for text elements)" },
          "fontSize": { "type": "number", "minimum": 1, "description": "Font size in pixels" },
          "clickable": { "type": "boolean", "description": "Whether the element accepts tap actions" },
          "draggable": { "type": "boolean", "description": "Whether the element can be dragged" },
          "hidden": { "type": "boolean", "description": "Whether the element starts hidden" },
          "zIndex": { "type": "integer", "description": "Rendering layer order" }
        }
      }
    },
    "solution": {
      "type": "object",
      "required": ["action"],
      "description": "The correct action that solves the puzzle",
      "properties": {
        "action": {
          "type": "string",
          "enum": ["tap", "drag", "sequence"],
          "description": "Action type"
        },
        "targetId": {
          "type": "string",
          "description": "Target element ID (for tap actions)"
        },
        "sourceId": {
          "type": "string",
          "description": "Source element ID (for drag actions)"
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "description": "Ordered element IDs to tap (for sequence actions)"
        }
      }
    },
    "decoyActions": {
      "type": "array",
      "description": "Actions that look correct but are wrong (tap and drag only)",
      "items": {
        "type": "object",
        "required": ["action", "response", "message"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["tap", "drag"],
            "description": "Decoy action type"
          },
          "targetId": {
            "type": "string",
            "description": "Target element ID for tap decoys"
          },
          "sourceId": {
            "type": "string",
            "description": "Source element ID for drag decoys"
          },
          "response": {
            "type": "string",
            "description": "Animation to play (e.g. shake)"
          },
          "message": {
            "type": "string",
            "maxLength": 100,
            "description": "Feedback message shown to the player"
          }
        }
      }
    },
    "hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Hint text shown when the player requests help"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Difficulty rating from 1 (easy) to 5 (hard)"
    }
  }
}
